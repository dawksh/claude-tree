#!/usr/bin/env bash
# supertree: git worktree + tmux + coding-agent harness
set -euo pipefail

# tmux may launch this outside an interactive shell
PATH="$HOME/.local/bin:$HOME/.opencode/bin:/opt/homebrew/bin:$PATH"

ST_WORKTREE_ROOT="${ST_WORKTREE_ROOT:-$HOME/projects/.worktrees}"
ST_STATE="${ST_STATE:-$HOME/.local/state/supertree}"
ST_REPOS="$ST_STATE/repos"
ST_CONFIG="${ST_CONFIG:-$HOME/.config/supertree/config}"

# Config is shell syntax, like .supertree. Environment variables win so a
# one-off `ST_HARNESS=codex st new ...` does what it says.
_env_harness=${ST_HARNESS:-}
_env_harness_command=${ST_HARNESS_COMMAND:-}
_env_harness_resume_command=${ST_HARNESS_RESUME_COMMAND:-}
# shellcheck disable=SC1090
[ -f "$ST_CONFIG" ] && . "$ST_CONFIG"
[ -n "$_env_harness" ] && ST_HARNESS=$_env_harness
[ -n "$_env_harness_command" ] && ST_HARNESS_COMMAND=$_env_harness_command
[ -n "$_env_harness_resume_command" ] && ST_HARNESS_RESUME_COMMAND=$_env_harness_resume_command
ST_HARNESS=${ST_HARNESS:-claude}
ST_HARNESS_COMMAND=${ST_HARNESS_COMMAND:-}
ST_HARNESS_RESUME_COMMAND=${ST_HARNESS_RESUME_COMMAND:-}

die()  { printf 'st: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[2m::\033[0m %s\n' "$*" >&2; }

slugify() { printf '%s' "$1" | tr '/.: ' '----'; }

harness_window() {
  case $ST_HARNESS in
    claude|codex|openrouter) printf '%s' "$ST_HARNESS";;
    *[!A-Za-z0-9_-]*|'') die "invalid ST_HARNESS: $ST_HARNESS";;
    *) [ -n "$ST_HARNESS_COMMAND" ] || die "unknown harness '$ST_HARNESS' (set ST_HARNESS_COMMAND)"
       printf '%s' "$ST_HARNESS";;
  esac
}

harness_bin() {
  case $ST_HARNESS in
    claude) printf 'claude';;
    codex) printf 'codex';;
    openrouter) printf 'opencode';;
    *) harness_window >/dev/null; printf '%s' "${ST_HARNESS_COMMAND%% *}";;
  esac
}

harness_label() {
  case $ST_HARNESS in
    claude) printf 'Claude Code';;
    codex) printf 'Codex';;
    openrouter) printf 'OpenRouter via OpenCode';;
    *) harness_window;;
  esac
}

main_worktree() {
  git -C "${1:-.}" worktree list --porcelain 2>/dev/null |
    awk 'NR==1 && /^worktree /{print substr($0,10)}'
}

require_repo() {
  local m
  m=$(main_worktree "${1:-.}") || true
  [ -n "$m" ] || die "not inside a git repository"
  printf '%s' "$m"
}

register_repo() {
  mkdir -p "$ST_STATE"
  grep -qxF "$1" "$ST_REPOS" 2>/dev/null || printf '%s\n' "$1" >> "$ST_REPOS"
}

tree_dir()  { printf '%s/%s/%s' "$ST_WORKTREE_ROOT" "$1" "$2"; }
sess_name() { printf '%s/%s' "$1" "$2"; }

# stable small integer per tree, for port derivation
tree_index() {
  local repo=$1 slug=$2 f="$ST_STATE/idx/$1/$2" n
  if [ -f "$f" ]; then cat "$f"; return; fi
  mkdir -p "$ST_STATE/idx/$repo"
  n=$(cat "$ST_STATE/idx/$repo"/* 2>/dev/null | sort -n | tail -1)
  n=$(( ${n:-0} + 1 ))
  printf '%s\n' "$n" | tee "$f"
}

# ---------------------------------------------------------------- bootstrap

bootstrap() {
  local main=$1 dir=$2 repo=$3 branch=$4 idx=$5
  local -a ST_LINK_DIRS=(node_modules)
  local -a ST_COPY_GLOBS=('.env*')
  local -a ST_LOCKFILES=(package-lock.json yarn.lock pnpm-lock.yaml bun.lockb)
  local ST_INSTALL_CMD='npm ci'
  local ST_POST_CREATE=''

  # shellcheck disable=SC1091
  [ -f "$main/.supertree" ] && . "$main/.supertree"

  local locks_match=1 needs_install=0 l d g f
  for l in "${ST_LOCKFILES[@]}"; do
    [ -f "$main/$l" ] || continue
    cmp -s "$main/$l" "$dir/$l" || locks_match=0
  done

  for d in "${ST_LINK_DIRS[@]}"; do
    [ -d "$main/$d" ] || continue
    [ -e "$dir/$d" ] && continue
    if [ "$locks_match" = 1 ]; then
      ln -s "$main/$d" "$dir/$d"
      info "linked $d -> main checkout"
    else
      needs_install=1
    fi
  done

  if [ "$needs_install" = 1 ] && [ -n "$ST_INSTALL_CMD" ]; then
    info "lockfile differs from main, running: $ST_INSTALL_CMD"
    ( cd "$dir" && eval "$ST_INSTALL_CMD" )
  fi

  for g in "${ST_COPY_GLOBS[@]}"; do
    for f in "$main"/$g; do
      [ -e "$f" ] || continue
      cp -R "$f" "$dir/"
      info "copied $(basename "$f")"
    done
  done

  if [ -n "$ST_POST_CREATE" ]; then
    info "post-create hook"
    ( cd "$dir"
      export ST_TREE_DIR="$dir" ST_TREE_BRANCH="$branch" ST_TREE_INDEX="$idx"
      eval "$ST_POST_CREATE" )
  fi
}

# ------------------------------------------------------------------- tmux

st_self() { command -v st 2>/dev/null || printf '%s' "$HOME/.local/bin/st"; }

build_session() {
  local sess=$1 dir=$2 self agent
  tmux has-session -t "=$sess" 2>/dev/null && return 0
  self=$(st_self)
  agent=$(harness_window)
  tmux new-session -d -s "$sess" -c "$dir" -n "$agent" "$self _run _agent"
  tmux new-window  -d -t "=$sess" -c "$dir" -n vim   "$self _run nvim"
  tmux new-window  -d -t "=$sess" -c "$dir" -n shell
  tmux select-window -t "=$sess:$agent"
}

tty_key() { printf '%s' "$1" | tr '/' '-'; }

# remember which session a client came from, so closing a tree can send it back
# instead of letting tmux detach it (detach-on-destroy defaults to on)
remember_origin() {
  local tty cur
  tty=$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{client_tty}' 2>/dev/null) || return 0
  cur=$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#S' 2>/dev/null) || return 0
  [ -n "$tty" ] && [ -n "$cur" ] && [ "$cur" != "$1" ] || return 0
  mkdir -p "$ST_STATE/origin"
  printf '%s\n' "$cur" > "$ST_STATE/origin/$(tty_key "$tty")"
}

# move every client off $1 before it is killed
evacuate_clients() {
  local sess=$1 ttys tty origin other
  ttys=$(tmux list-clients -t "=$sess" -F '#{client_tty}' 2>/dev/null) || return 0
  [ -n "$ttys" ] || return 0
  while read -r tty; do
    [ -n "$tty" ] || continue
    origin=$(cat "$ST_STATE/origin/$(tty_key "$tty")" 2>/dev/null) || origin=""
    if [ -n "$origin" ] && [ "$origin" != "$sess" ] && tmux has-session -t "=$origin" 2>/dev/null; then
      tmux switch-client -c "$tty" -t "=$origin" 2>/dev/null && continue
    fi
    # fall back to the most recently used other session
    other=$(tmux list-sessions -F '#{session_last_attached}|#{session_name}' 2>/dev/null |
      sort -rn | cut -d'|' -f2- | grep -vxF -- "$sess" | head -1) || other=""
    [ -n "$other" ] && tmux switch-client -c "$tty" -t "=$other" 2>/dev/null || true
  done <<EOF
$ttys
EOF
}

attach() {
  local sess=$1
  if [ -n "${TMUX:-}" ]; then
    remember_origin "$sess"
    tmux switch-client -t "=$sess"
  else
    tmux attach-session -t "=$sess"
  fi
}

# repo<TAB>branch<TAB>dir  for every worktree of every known repo
list_trees() {
  local r
  [ -f "$ST_REPOS" ] || return 0
  while read -r r; do
    [ -d "$r" ] || continue
    git -C "$r" worktree list --porcelain 2>/dev/null | awk -v repo="$(basename "$r")" '
      /^worktree /{p=substr($0,10)}
      /^branch /{b=$2; sub("refs/heads/","",b); print repo"\t"b"\t"p}
      /^detached$/{print repo"\t(detached)\t"p}'
  done < "$ST_REPOS"
}

# ---------------------------------------------------------------- commands

cmd_new() {
  local branch="" base="" bare=0 repo_arg=""
  while [ $# -gt 0 ]; do
    case $1 in
      --from) base=$2; shift 2;;
      --repo) repo_arg=$2; shift 2;;
      --bare) bare=1; shift;;
      -*) die "unknown flag: $1";;
      *) branch=$1; shift;;
    esac
  done
  [ -n "$branch" ] || die "usage: st new <branch> [--from <base>] [--bare]"

  local main repo slug dir sess idx
  main=$(require_repo "${repo_arg:-.}")
  repo=$(basename "$main")
  slug=$(slugify "$branch")
  dir=$(tree_dir "$repo" "$slug")
  sess=$(sess_name "$repo" "$slug")
  register_repo "$main"

  if [ -d "$dir" ]; then
    info "worktree already exists: $dir"
  else
    mkdir -p "$(dirname "$dir")"
    if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$main" worktree add "$dir" "$branch"
    else
      git -C "$main" worktree add -b "$branch" "$dir" ${base:+"$base"}
    fi
  fi

  idx=$(tree_index "$repo" "$slug")
  if [ "$bare" = 0 ]; then
    bootstrap "$main" "$dir" "$repo" "$branch" "$idx"
    build_session "$sess" "$dir"
    attach "$sess"
  else
    info "bare: skipped deps, env and agent"
    printf '%s\n' "$dir"
  fi
}

cmd_go() {
  local picker=0 query=""
  while [ $# -gt 0 ]; do
    case $1 in
      --picker) picker=1; shift;;
      *) query=$1; shift;;
    esac
  done

  local rows sel dir sess
  rows=$(list_trees | while IFS=$'\t' read -r repo branch path; do
    local s live
    s=$(sess_name "$repo" "$(slugify "$branch")")
    if tmux has-session -t "=$s" 2>/dev/null; then live='●'; else live='·'; fi
    printf '%s %s\t%s\t%s\n' "$live" "$s" "$path" "$s"
  done)

  [ -n "$rows" ] || die "no worktrees known yet — run 'st new <branch>' inside a repo"

  if [ -n "$query" ]; then
    sel=$(printf '%s\n' "$rows" | grep -i -- "$query" | head -1) || true
    [ -n "$sel" ] || die "no tree matching: $query"
  else
    sel=$(printf '%s\n+ new branch…\t\t\n' "$rows" |
      fzf --delimiter=$'\t' --with-nth=1 --height=100% --reverse \
          --prompt='tree> ' --preview-window=hidden) || return 0
  fi

  case $sel in
    '+ new branch'*)
      local b r
      printf 'branch: ' >&2; read -r b
      [ -n "$b" ] || return 0
      r=$(sort -u "$ST_REPOS")
      if [ "$(printf '%s\n' "$r" | wc -l)" -gt 1 ]; then
        r=$(printf '%s\n' "$r" | fzf --prompt='repo> ' --height=100% --reverse) || return 0
      fi
      cmd_new "$b" --repo "$r"
      return;;
  esac

  dir=$(printf '%s' "$sel" | cut -f2)
  sess=$(printf '%s' "$sel" | cut -f3)
  build_session "$sess" "$dir"
  attach "$sess"
}

cmd_ls() {
  local repo branch path s live dirty
  printf '%-3s %-28s %-8s %s\n' '' 'TREE' 'STATE' 'PATH'
  list_trees | while IFS=$'\t' read -r repo branch path; do
    s=$(sess_name "$repo" "$(slugify "$branch")")
    if tmux has-session -t "=$s" 2>/dev/null; then live='live'; else live='-'; fi
    if [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then dirty='*'; else dirty=' '; fi
    printf '%-3s %-28s %-8s %s\n' "$dirty" "$s" "$live" "$path"
  done
}

cmd_rm() {
  local branch="" force=0
  while [ $# -gt 0 ]; do
    case $1 in
      --force|-f) force=1; shift;;
      *) branch=$1; shift;;
    esac
  done
  [ -n "$branch" ] || die "usage: st rm <branch> [--force]"

  local main repo slug dir sess dirty unpushed
  main=$(require_repo .)
  repo=$(basename "$main")
  slug=$(slugify "$branch")
  dir=$(tree_dir "$repo" "$slug")
  sess=$(sess_name "$repo" "$slug")
  [ -d "$dir" ] || die "no worktree for $branch at $dir"

  dirty=$(git -C "$dir" status --porcelain 2>/dev/null || true)
  if git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    unpushed=$(git -C "$dir" log --oneline '@{u}..' 2>/dev/null || true)
  elif [ -n "$(git -C "$dir" remote)" ]; then
    unpushed=$(git -C "$dir" log --oneline HEAD --not --remotes 2>/dev/null || true)
  else
    unpushed=''   # no remote configured, nothing can be "unpushed"
  fi

  if [ "$force" = 0 ] && [ -n "$dirty$unpushed" ]; then
    [ -n "$dirty" ]    && { printf 'uncommitted changes:\n%s\n' "$dirty" >&2; }
    [ -n "$unpushed" ] && { printf 'unpushed commits:\n%s\n' "$unpushed" >&2; }
    die "refusing to remove $branch — commit/push, or pass --force"
  fi

  printf 'will remove:\n  session  %s\n  worktree %s\n  branch   %s (only if merged)\n' "$sess" "$dir" "$branch" >&2
  printf 'proceed? [y/N] ' >&2; read -r ans
  case ${ans:-n} in y|Y|yes) ;; *) die "aborted";; esac

  evacuate_clients "$sess"
  tmux kill-session -t "=$sess" 2>/dev/null || true
  if [ "$force" = 1 ]; then git -C "$main" worktree remove --force "$dir"
  else git -C "$main" worktree remove "$dir"; fi
  git -C "$main" branch -d "$branch" 2>/dev/null || info "branch $branch kept (not merged)"
  rm -f "$ST_STATE/idx/$repo/$slug" \
    "$ST_STATE/seen/$repo/$slug" \
    "$ST_STATE/seen/$repo/$slug.$ST_HARNESS" \
    "$ST_STATE/seen/$repo/$slug.claude" \
    "$ST_STATE/seen/$repo/$slug.codex" \
    "$ST_STATE/seen/$repo/$slug.openrouter"
  info "removed $sess"
}

# session names of every known tree (guard: never touch non-st sessions)
known_sessions() {
  list_trees | while IFS=$'\t' read -r repo branch path; do
    sess_name "$repo" "$(slugify "$branch")"; printf '\n'
  done
}

live_sessions() {
  local s
  known_sessions | while read -r s; do
    [ -n "$s" ] || continue
    tmux has-session -t "=$s" 2>/dev/null && printf '%s\n' "$s"
  done
}

cmd_down() {
  local yes=0 target="" s live
  while [ $# -gt 0 ]; do
    case $1 in
      -y|--yes) yes=1; shift;;
      --all) target=--all; shift;;
      *) target=$1; shift;;
    esac
  done

  if [ "$target" = --all ]; then
    live=$(live_sessions)
    [ -n "$live" ] || { info "no tree sessions open"; return 0; }
    printf 'will close:\n%s\n' "$live" >&2
    if [ "$yes" = 0 ]; then
      printf 'unsaved editor buffers are lost. proceed? [y/N] ' >&2; read -r ans
      case ${ans:-n} in y|Y|yes) ;; *) die "aborted";; esac
    fi
    printf '%s\n' "$live" | while read -r s; do evacuate_clients "$s"; tmux kill-session -t "=$s"; done
    info "closed all tree sessions (worktrees kept)"
    return 0
  fi

  local all
  all=$(known_sessions)

  if [ -n "$target" ]; then
    case $'\n'"$all"$'\n' in
      *$'\n'"$target"$'\n'*) s=$target;;
      *) s=$(printf '%s\n' "$all" | grep -i -- "$target" | head -1) || true;;
    esac
    [ -n "$s" ] || die "no tree matching: $target"
  elif [ -n "${TMUX:-}" ]; then
    s=$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#S')
  else
    die "usage: st down [branch|--all]  (no branch only works inside a tree session)"
  fi

  # guard: only ever kill sessions that belong to a known worktree
  case $'\n'"$all"$'\n' in
    *$'\n'"$s"$'\n'*) ;;
    *) die "$s is not a supertree session, refusing to kill it";;
  esac

  tmux has-session -t "=$s" 2>/dev/null || { info "$s already closed"; return 0; }
  evacuate_clients "$s"
  tmux kill-session -t "=$s"
  info "closed $s (worktree kept — 'st resume' brings it back)"
}

cmd_toggle() {
  local pane cur sess target dir self
  pane=${TMUX_PANE:-}
  if [ -n "$pane" ]; then
    cur=$(tmux display-message -p -t "$pane" '#W')
    sess=$(tmux display-message -p -t "$pane" '#S')
  else
    cur=$(tmux display-message -p '#W'); sess=$(tmux display-message -p '#S')
  fi
  target=$(harness_window)
  if [ "$cur" = "$target" ]; then target=vim; fi
  tmux select-window -t "=$sess:$target" 2>/dev/null && return 0
  dir=$(tmux display-message -p -t "${pane:-$sess}" '#{pane_current_path}')
  self=$(st_self)
  if [ "$target" = vim ]; then
    tmux new-window -t "=$sess" -c "$dir" -n vim "$self _run nvim"
  else
    tmux new-window -t "=$sess" -c "$dir" -n "$target" "$self _run _agent"
  fi
}

cmd_agent() {
  local pane sess target dir self
  pane=${TMUX_PANE:-}
  if [ -n "$pane" ]; then sess=$(tmux display-message -p -t "$pane" '#S')
  else sess=$(tmux display-message -p '#S'); fi
  target=$(harness_window)
  tmux select-window -t "=$sess:$target" 2>/dev/null && return 0
  dir=$(tmux display-message -p -t "${pane:-$sess}" '#{pane_current_path}')
  self=$(st_self)
  tmux new-window -t "=$sess" -c "$dir" -n "$target" "$self _run _agent"
}

# window entrypoint: run the program, then drop to a shell in the same tree
cmd_run() {
  case ${1:-} in
    _agent) cmd_harness || true;;
    _claude) ST_HARNESS=claude cmd_harness || true;; # old live sessions
    *) "$@" || true;;
  esac
  exec "${SHELL:-/bin/zsh}" -i
}

# launcher used by the agent window; resumes this tree's own conversation
cmd_harness() {
  local repo slug marker legacy bin
  repo=$(basename "$(main_worktree .)")
  slug=$(slugify "$(git branch --show-current 2>/dev/null || echo detached)")
  harness_window >/dev/null
  bin=$(harness_bin)
  command -v "$bin" >/dev/null 2>&1 || die "$(harness_label) is selected but '$bin' is not installed"
  marker="$ST_STATE/seen/$repo/$slug.$ST_HARNESS"
  legacy="$ST_STATE/seen/$repo/$slug"
  mkdir -p "$(dirname "$marker")"
  if [ -f "$marker" ] || { [ "$ST_HARNESS" = claude ] && [ -f "$legacy" ]; }; then
    case $ST_HARNESS in
      claude) claude --continue || claude;;
      codex) codex resume --last || codex;;
      openrouter) opencode --continue || opencode;;
      *) if [ -n "$ST_HARNESS_RESUME_COMMAND" ]; then
           eval "$ST_HARNESS_RESUME_COMMAND" || eval "$ST_HARNESS_COMMAND"
         else
           eval "$ST_HARNESS_COMMAND"
         fi;;
    esac
  else
    : > "$marker"
    case $ST_HARNESS in
      claude) claude;;
      codex) codex;;
      openrouter) opencode;;
      *) eval "$ST_HARNESS_COMMAND";;
    esac
  fi
}

cmd_doctor() {
  local ok=0 b agent_bin
  agent_bin=$(harness_bin)
  for b in tmux git fzf nvim "$agent_bin"; do
    if command -v "$b" >/dev/null 2>&1; then printf '  ok    %s\n' "$b"
    else printf '  MISS  %s\n' "$b"; ok=1; fi
  done
  local self; self=$(command -v st 2>/dev/null) || self=""
  if [ -n "$self" ]; then printf '  ok    st on PATH (%s)\n' "$self"
  else printf '  MISS  st not on PATH\n'; ok=1; fi
  if grep -q 'supertree.conf' "$HOME/.tmux.conf" 2>/dev/null; then printf '  ok    ~/.tmux.conf sources supertree.conf\n'
  else printf '  MISS  ~/.tmux.conf does not source supertree.conf\n'; ok=1; fi
  printf '  --    worktree root %s\n' "$ST_WORKTREE_ROOT"
  printf '  --    repos known   %s\n' "$( [ -f "$ST_REPOS" ] && wc -l < "$ST_REPOS" | tr -d ' ' || echo 0)"
  printf '  --    harness       %s (%s)\n' "$(harness_label)" "$ST_HARNESS"
  printf '  --    config        %s\n' "$ST_CONFIG"
  return $ok
}

usage() {
  cat <<'USAGE'
st — supertree: worktree + tmux + coding-agent harness

  st new <branch> [--from <base>] [--bare]   create worktree, bootstrap, open session
  st go [query]                              pick a tree (fzf) and switch to it
  st resume [query]                          same as go — reopens a closed tree, agent continues
  st down [branch|--all]                     close the tree's session, keep the worktree
  st ls                                      list worktrees, session state, dirtiness
  st rm <branch> [--force]                   kill session, remove worktree, prune branch
  st doctor                                  check the install

keys (inside tmux)
  M-w   tree picker          M-e   toggle agent <-> vim
  M-1   agent    M-2 vim   M-3 shell
  M-q   close this tree (session only)
USAGE
}

case ${1:-} in
  new)    shift; cmd_new "$@";;
  go)     shift; cmd_go "$@";;
  resume) shift; cmd_go "$@";;
  down)   shift; cmd_down "$@";;
  ls)     shift; cmd_ls "$@";;
  rm)     shift; cmd_rm "$@";;
  toggle) shift; cmd_toggle "$@";;
  agent)  shift; cmd_agent "$@";;
  doctor) shift; cmd_doctor "$@";;
  _sessions) shift; known_sessions;;
  _run)    shift; cmd_run "$@";;
  _agent)  shift; cmd_harness "$@";;
  _claude) shift; ST_HARNESS=claude cmd_harness "$@";;
  ''|-h|--help|help) usage;;
  *) die "unknown command: $1 (try: st help)";;
esac
